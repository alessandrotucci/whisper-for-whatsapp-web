<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_model" />

        <TextView
            style="@style/Hint"
            android:text="@string/model_hint" />

        <RadioGroup
            android:id="@+id/models"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <ProgressBar
            android:id="@+id/download_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_download" />

            <Button
                android:id="@+id/btn_cancel_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@android:string/cancel" />

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_delete" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_language" />

        <Spinner
            android:id="@+id/language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Revisione e traduzione con l'IA: la riempie AiSettings -->
        <LinearLayout
            android:id="@+id/ai_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/ai_title" />

            <TextView
                style="@style/Hint"
                android:text="@string/ai_intro" />

            <Switch
                android:id="@+id/ai_revise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="@string/ai_revise"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <TextView
                android:id="@+id/ai_revise_note"
                style="@style/Hint"
                android:text="@string/ai_revise_note" />

            <Switch
                android:id="@+id/ai_translate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="@string/ai_translate"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <Spinner
                android:id="@+id/ai_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/ai_empty_note"
                style="@style/Hint"
                android:paddingTop="8dp"
                android:text="@string/ai_empty_note" />

            <TextView
                android:id="@+id/ai_accounts_title"
                style="@style/SectionTitle"
                android:paddingTop="16dp"
                android:text="@string/ai_accounts"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <LinearLayout
                android:id="@+id/ai_accounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_ai_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_add" />

            <LinearLayout
                android:id="@+id/ai_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Hint"
                    android:paddingTop="8dp"
                    android:text="@string/ai_timeout_hint" />

                <Spinner
                    android:id="@+id/ai_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Switch
                    android:id="@+id/ai_context"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="@string/ai_context"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/ai_context_note" />

                <TextView
                    style="@style/Hint"
                    android:paddingTop="8dp"
                    android:text="@string/ai_keys_note" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_threads" />

        <TextView
            style="@style/Hint"
            android:text="@string/threads_hint" />

        <Spinner
            android:id="@+id/threads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Hint"
            android:paddingTop="8dp"
            android:text="@string/threads_bg_hint" />

        <Spinner
            android:id="@+id/threads_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_sources" />

        <TextView
            android:id="@+id/listener_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/btn_listener"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_open_settings" />

        <TextView
            android:id="@+id/folder_whatsapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/btn_folder_whatsapp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_choose" />

        <TextView
            android:id="@+id/folder_business"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/btn_folder_business"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_choose" />

        <TextView
            style="@style/Hint"
            android:paddingTop="8dp"
            android:text="@string/folder_hint" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_test" />

        <Button
            android:id="@+id/btn_test_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_file" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_info" />

        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
