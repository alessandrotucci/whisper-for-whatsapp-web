<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_model" />

        <TextView
            style="@style/Hint"
            android:text="@string/model_hint" />

        <RadioGroup
            android:id="@+id/models"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <ProgressBar
            android:id="@+id/download_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_download" />

            <Button
                android:id="@+id/btn_cancel_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@android:string/cancel" />

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_delete" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_language" />

        <Spinner
            android:id="@+id/language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_threads" />

        <TextView
            style="@style/Hint"
            android:text="@string/threads_hint" />

        <Spinner
            android:id="@+id/threads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Hint"
            android:paddingTop="8dp"
            android:text="@string/threads_bg_hint" />

        <Spinner
            android:id="@+id/threads_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/background_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-8dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_background" />

            <TextView
                style="@style/Hint"
                android:text="@string/background_hint" />

            <include
                android:id="@+id/bg_battery"
                layout="@layout/item_check" />

            <include
                android:id="@+id/bg_activity"
                layout="@layout/item_check" />

            <include
                android:id="@+id/bg_autostart"
                layout="@layout/item_check" />

            <TextView
                android:id="@+id/bg_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_problem_box"
                android:lineSpacingMultiplier="1.15"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textColor="@color/problem_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/bg_no_problem"
                style="@style/Hint"
                android:layout_marginTop="8dp"
                android:text="@string/bg_no_problem" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_sources" />

        <TextView
            android:id="@+id/listener_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/btn_listener"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_open_settings" />

        <TextView
            android:id="@+id/folder_whatsapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/btn_folder_whatsapp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_choose" />

        <TextView
            android:id="@+id/folder_business"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/btn_folder_business"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_choose" />

        <TextView
            style="@style/Hint"
            android:paddingTop="8dp"
            android:text="@string/folder_hint" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_test" />

        <Button
            android:id="@+id/btn_test_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_file" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_info" />

        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
